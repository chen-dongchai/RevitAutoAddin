<Page x:Class="RevitAutoAddin.Pages.SetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RevitAutoAddin.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SetPage">

    <Grid ShowGridLines="false" Background="#FFEFE4">
        <Grid.RowDefinitions>
           
            <RowDefinition Height="4*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="12*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Background="#FFEADB" />
        <TextBlock Text="命令类型Type"  Grid.Row="0" Grid.Column="1" Margin="10,0,20,0" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"  FontSize="20" Foreground="#424769"/>
        <TextBlock Text=".dll地址" Grid.Row="1" Grid.Column="1" Margin="20,20,20,20" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"  FontSize="20" Foreground="#424769"/>
        <TextBlock Text="GUID" Grid.Row="2" Grid.Column="1" Margin="20,20,20,20" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"  FontSize="20" Foreground="#424769"/>
        <TextBlock Text="项目名Text" Grid.Row="3" Grid.Column="1" Margin="20,20,20,20" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"  FontSize="20" Foreground="#424769"/>
        <TextBlock Text="FullClassName" Grid.Row="4" Grid.Column="1" Margin="10,20,20,10" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center"  FontSize="20" Foreground="#424769"/>
        
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="CommandRadioButton" GroupName="Typechoosed" Checked="TypeRadioButton_Checked" Content="Command" Grid.Row="0" Grid.Column="0"  Height="25" Width="150" FontSize="17" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch" Foreground="#424769"/>
            <RadioButton x:Name="ApplicationRadioButton" GroupName="Typechoosed" Checked="TypeRadioButton_Checked" Content="Application"  Grid.Row="0" Grid.Column="1"  Height="25" Width="150" FontSize="17" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch" Foreground="#424769"/>
        </Grid>
        <Grid Grid.Row=" 1" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilePathTextBox" Grid.Row="0" Grid.Column="0" Margin="20,0,20,0" FontSize="10" VerticalContentAlignment="Center" MinHeight="30" VerticalAlignment="Center" />
            <Button x:Name="BrowseButton" Click="BrowseButton_Click" Content="浏览" Grid.Row="0" Grid.Column="1" Margin="10,10,10,10" Width="55" Height="30" FontSize="15" VerticalAlignment="Center"/>
        </Grid>
        
        <TextBox x:Name="GUIDTextBox" Grid.Row="2" Grid.Column="2" Margin="20,20,20,20" FontSize="10" MinHeight="30" VerticalAlignment="Center" />
        <TextBox x:Name="ProgramNameTextBox" Grid.Row="3" Grid.Column="2" Margin="20,20,20,20" FontSize="10" MinHeight="30" VerticalAlignment="Center" />
        <TextBox x:Name="ClassNameTextBox" Grid.Row="4" Grid.Column="2" Margin="20,20,20,20" FontSize="10" MinHeight="30" VerticalAlignment="Center" />
    </Grid>
</Page>
