<ui:FluentWindow   x:Class="RevitAutoAddin.MainWindow"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RevitAutoAddin"
        mc:Ignorable="d"
        Title="RevitAutoAddin" Height="500" Width="850"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  WindowCornerPreference="Round"
                   AllowsTransparency="False"
                   WindowStartupLocation="CenterScreen"
                   WindowStyle="None"
                   >
    
    <Grid ShowGridLines="False" Background="#FFEADB">
        <Grid.RowDefinitions>

            <RowDefinition Height="11*"/>

        </Grid.RowDefinitions>

        <Grid ShowGridLines="False" Grid.Row=" 0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>
            <Grid Background="#F7C5A8" Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="8*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row=" 1" Grid.Column="0">
                    <Button x:Name="SetButton"  HorizontalAlignment="Stretch" Click="SetButton_Click"  FontSize="15"  Height="40">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/images/edit.png" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ViewButton" HorizontalAlignment="Stretch" Click="ViewButton_Click"  FontSize="15" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/images/search-alt.png" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="预览" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Image gif:AnimationBehavior.SourceUri="/Images/text.gif"
                        Width="120" Height="120"
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Bottom" 
                        Grid.Row="1"/>

            </Grid>
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Background="#FFEADB" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                    <Button x:Name="CloseButton"  Click="CloseButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Row="0" Grid.Column="0" Margin="10,10,10,10" FontSize="10">
                        <Image Source="/images/close.png" Width="15" Height="15"/>
                    </Button>
                </Grid>

                <Frame x:Name="contentFrame" NavigationUIVisibility="Hidden" Grid.Row="1" Grid.Column="0"/>
            </Grid>

        </Grid>
    </Grid>
</ui:FluentWindow>
